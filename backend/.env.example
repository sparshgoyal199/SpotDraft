# ==============================================================================
# Lexora — Environment Variables Template
# Copy this file to `.env` in the same directory and fill in your credentials.
# DO NOT commit the filled `.env` file to version control.
# ==============================================================================

# FastAPI Configuration
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Database & Storage Configuration
# Copy the connection URI and keys from your Supabase Dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_DB_URI=postgresql://postgres.your-project-id:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
BUCKET_NAME=pdfs

# Qdrant Vector DB Configuration
# Get your API key and URL from Qdrant Cloud console
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Model Provider APIs
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here
